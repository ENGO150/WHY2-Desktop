{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WHY2",
  "mainBinaryName": "why2-desktop",
  "version": "0.1.0",
  "identifier": "me.engo150.why2-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WHY2",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Václav Šmejkal",
    "homepage": "https://why2.satan.red",
    "copyright": "Copyright (C) 2026 Václav Šmejkal - GPL-3.0-only",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "SocialNetworking",
    "shortDescription": "Chat client for the WHY2 protocol",
    "longDescription": "Chat, voice calls and screen sharing over the WHY2 protocol, with a hybrid ECC and ML-KEM key exchange and TOFU key pinning. The same program on Linux, macOS, Windows and Android.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
